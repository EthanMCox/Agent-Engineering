VITE_API_BASE_URL=http://localhost:8000
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-nano
OPENAI_SUMMARIZER_MODEL=gpt-4.1-mini
OPENAI_SUMMARIZER_MAX_OUTPUT_TOKENS=800
OPENAI_LOG_REASONING_SUMMARIES=false
OPENAI_REASONING_EFFORT=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CANVAS_MCP_ENABLED=false
CANVAS_MCP_COMMAND=npx canvas-mcp-server
CANVAS_MCP_WORKDIR=.\mcp-canvas
CANVAS_MCP_STARTUP_TIMEOUT_SECONDS=15
CANVAS_MCP_CALL_TIMEOUT_SECONDS=20
CANVAS_MCP_COURSE_LIMIT=3
CANVAS_MCP_ASSIGNMENTS_LIMIT=8
CONTEXT_MAX_INPUT_TOKENS=220000
CONTEXT_RESERVED_OUTPUT_TOKENS=24000
CONTEXT_RESERVED_SYSTEM_TOKENS=6000
TOOL_RESULT_MAX_TOKENS_PER_APPEND=12000
PAGINATION_DEFAULT_PAGE_SIZE=30
PAGINATION_MAX_PAGE_SIZE=100
PAGINATION_CACHE_TTL_SECONDS=900
PAGINATION_MAX_RESULTS_PER_SESSION=16
MCP_TOOL_MODE=denylist
MCP_TOOL_PROFILE=student
MCP_TOOL_DENYLIST=canvas_create_course,canvas_update_course,canvas_create_assignment,canvas_update_assignment,canvas_submit_grade,canvas_enroll_user,canvas_create_quiz,canvas_create_user,canvas_list_account_users,canvas_list_account_courses,canvas_get_account,canvas_create_account_report,canvas_get_account_reports,canvas_list_sub_accounts
MCP_TOOL_ALLOWLIST=
CANVAS_API_TOKEN=your_canvas_token_here
CANVAS_DOMAIN=your-school.instructure.com
